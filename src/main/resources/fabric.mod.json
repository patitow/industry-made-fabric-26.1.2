{
	"schemaVersion": 1,
	"id": "industry-made",
	"version": "${version}",
	"name": "Industry Made",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/industry-made/icon.png",
	"environment": "*",
	"accessWidener": "industry-made.accesswidener",
	"entrypoints": {
		"main": [
			{
				"value": "dev.patitow.industrymade.IndustryMade",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "dev.patitow.industrymade.client.IndustryMadeClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "dev.patitow.industrymade.client.IndustryMadeDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"industry-made.mixins.json",
		{
			"config": "industry-made.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}